# Copy this file to .env.local (already gitignored) for local development.
# Vite auto-loads .env.local, so `npm run dev` / `npm run build` will pick
# this up with no extra setup once it's copied.
#
# Optional: URL of the meal-photo-analysis backend (see worker/README.md).
# Leave both blank to use the manual dish search-and-confirm flow instead —
# the Nutrition tab works fine either way.
VITE_MEAL_ANALYZE_URL=
VITE_MEAL_ANALYZE_SECRET=
