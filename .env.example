# Copy this file to .env.local (already gitignored) for local development.
# Vite auto-loads .env.local, so `npm run dev` / `npm run build` will pick
# this up with no extra setup once it's copied.
#
# Password for the free-access admin login (email: admin@qualityworkout.app).
# See the comment above ADMIN_PASSWORD in src/pages/Auth.jsx for what this
# does and does not protect against.
VITE_ADMIN_PASSWORD=
